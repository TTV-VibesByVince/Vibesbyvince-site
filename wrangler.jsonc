{
  "name": "vibesbyvince-site",
  "compatibility_date": "2026-08-31",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // /assets/video/* also goes through the Worker so videos support
    // partial (Range) requests, which iPhone Safari needs to play them
    "run_worker_first": ["/api/*", "/assets/video/*"],
    // unknown URLs get the styled 404.html (with a real 404 status)
    "not_found_handling": "404-page"
  },
  // Stream calendar database (/calendar). Created in the Cloudflare
  // dashboard: Storage & Databases → D1 → "vibesbyvince-calendar".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibesbyvince-calendar",
      "database_id": "a5b8840e-d51d-4d1e-87e2-0a6590b163a8"
    }
  ]
}
